# Copy to .env and fill in. .env is gitignored.
#
#   snowshift lint                     needs nothing
#   snowshift deploy --dry-run         needs nothing
#   snowshift deploy                   needs the SNOWFLAKE_* block
#   snowshift parity                   needs both blocks

# --- Target: Snowflake -------------------------------------------------
SNOWFLAKE_ACCOUNT=abc12345.us-east-1
SNOWFLAKE_USER=migration_user
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=planning_admin

# Prefer SSO/MFA over a stored password where the account allows it.
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# --- Source: SQL Server (parity only) ----------------------------------
SOURCE_ODBC_DSN=Driver={ODBC Driver 18 for SQL Server};Server=localhost;Database=Planning;Trusted_Connection=yes;

# --- Overrides for manifest.yaml target block --------------------------
# SNOWSHIFT_DATABASE=SNOWCONVERT_DEMO
# SNOWSHIFT_SCHEMA=Planning
# SNOWSHIFT_WAREHOUSE=MIGRATION_WH
