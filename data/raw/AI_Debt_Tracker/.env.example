# Copy to .env and fill in. .env is gitignored — never commit it.
# The scripts load this file automatically (scripts/_localenv.py); shell variables take precedence.

# --- SEC EDGAR identity ---
# The SEC requires a declared User-Agent with a real name and email; requests without one get HTTP 403.
EDGAR_NAME=Your Name
EDGAR_EMAIL=you@example.edu

# --- Where the bulky files live: a local directory outside the repo ---
AI_DEBT_DATA=<local directory>/data
# uv puts the virtual environment and its package cache here instead of inside the repo
UV_PROJECT_ENVIRONMENT=<local directory>/venv
UV_CACHE_DIR=<local directory>/uv-cache

# --- Local models (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_FAST=qwen3:4b
# Ollama reads OLLAMA_MODELS from its own environment, not from this file:
# set OLLAMA_MODELS=<local directory>/ollama-models before `ollama serve` (see README).
OLLAMA_MODELS=<local directory>/ollama-models
